import { Theme } from "../../theme.slint";
import { SidebarItem } from "items.slint";
import { SidebarFooter } from "footer.slint";
import { AppState, Page } from "../../state.slint";
export component Sidebar {
    width: 50px; // Sidebar width

    Rectangle {
        background: Theme.bg-secondary;

        // Sidebar items
        VerticalLayout {
            alignment: start;
            spacing: 30px;
            padding-top: 70px;
            SidebarItem {
                icon: @image-url("../../assets/svg/sidebar/home.svg");
                label: "خانه";
                active: AppState.page == Page.home;
                clicked => { AppState.page = Page.home }
            }

            SidebarItem {
                icon: @image-url("../../assets/svg/sidebar/parameters.svg");
                label: "داده های لحظه ای";
                active: AppState.page == Page.parameters;
                clicked => { AppState.page = Page.parameters }
            }

            SidebarItem {
                icon: @image-url("../../assets/svg/sidebar/chart.svg");
                label: "نمودار لحظه ای";
                active: AppState.page == Page.dashboard;
                clicked => { AppState.page = Page.dashboard }
            }

            SidebarItem {
                icon: @image-url("../../assets/svg/sidebar/error.svg");
                label: "عیب یابی";
                active: AppState.page == Page.diagnostics;
                clicked => { AppState.page = Page.diagnostics }
            }

            SidebarItem {
                icon: @image-url("../../assets/svg/sidebar/book.svg");
                label: "کتابچه خودرو";
                active: AppState.page == Page.book;
                clicked => { AppState.page = Page.book }
            }

            SidebarItem {
                icon: @image-url("../../assets/svg/sidebar/ai.svg");
                label: "هوش مصنوعی";
                active: AppState.page == Page.ai;
                clicked => { AppState.page = Page.ai }
            }
        }

        // Sidebar footer
        VerticalLayout {
            alignment: end;
            spacing: 22px;
            padding-bottom: 14px;
            SidebarFooter {
                icon: @image-url("../../assets/svg/sidebar/about.svg");
                label: "درباره ما";
                active: AppState.page == Page.about-us;
                clicked => { AppState.page = Page.about-us }
            }

            SidebarFooter {
                icon: @image-url("../../assets/svg/sidebar/setting.svg");
                label: "تنظیمات";
                active: AppState.page == Page.setting;
                clicked => { AppState.page = Page.setting }
            }
        }
    }

    // Sidebar border line
    Rectangle {
        x: 0px - 1.5px;
        y: 50px - 1.5px;
        width: 1.5px;
        background: Theme.border;
    }
}
